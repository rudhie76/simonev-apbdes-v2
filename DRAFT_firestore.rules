rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\- ]+$');
    }

    function isNumeric(val) {
      return val is int || val is float;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to check for Activity entity shape and limits
    function isValidActivity(data) {
      return data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 250
        && data.village is string
        && (data.village == 'Bangun Mulya' || data.village == 'Sesulu' || data.village == 'Api-api')
        && data.sector is string
        && (data.sector == 'Penyelenggaraan Pemerintahan' 
            || data.sector == 'Pembangunan Desa (Infrastruktur)' 
            || data.sector == 'Pembinaan Kemasyarakatan' 
            || data.sector == 'Pemberdayaan Masyarakat' 
            || data.sector == 'Penanggulangan Bencana & Mendesak')
        && data.budgetTotal is int
        && data.budgetTotal >= 0
        && data.budgetSpent is int
        && data.budgetSpent >= 0
        && data.budgetSpent <= data.budgetTotal
        && data.progressPhysical is int
        && data.progressPhysical >= 0
        && data.progressPhysical <= 100
        && data.status is string
        && (data.status == 'BELUM_MULAI' || data.status == 'DALAM_PROSES' || data.status == 'MENUNGGU_EVALUASI' || data.status == 'SELESAI')
        && data.isKecamatanApproved is bool
        && data.createdAt is string
        && data.lastUpdated is string;
    }

    // Helper to check for Notification Log entity shape
    function isValidLog(data) {
      return data.id is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 1000
        && data.timestamp is string
        && data.type is string
        && (data.type == 'info' || data.type == 'success' || data.type == 'warn' || data.type == 'approval');
    }

    // Collection: Activities
    match /activities/{activityId} {
      allow read: if true;
      
      allow create: if isValidId(activityId) 
        && isValidActivity(incoming())
        && incoming().id == activityId
        && incoming().isKecamatanApproved == false
        && incoming().progressPhysical == 0 
        && incoming().status == 'BELUM_MULAI';

      allow update: if isValidId(activityId)
        && isValidActivity(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().village == existing().village
        && (
          // Terminal lock protection: check if existing state is already fully approved/ACC
          existing().isKecamatanApproved == false 
          || incoming().isKecamatanApproved == true // keep existing approval
        );

      allow delete: if isValidId(activityId);
    }

    // Collection: Notification Logs
    match /logs/{logId} {
      allow read: if true;
      
      allow create: if isValidId(logId)
        && isValidLog(incoming())
        && incoming().id == logId;
        
      allow update, delete: if false; // Logs are write-once audit trails
    }

    // Collection: Siskeudes Pagu (imported village APBDes budget ceiling)
    match /siskeudes_pagu/{villageId} {
      allow read: if true;
      allow create, update: if isValidId(villageId)
        && incoming().village == villageId
        && isNumeric(incoming().paguTotal)
        && incoming().lastSynced is string
        && incoming().isSynced is bool;
      allow delete: if false;
    }
  }
}
